---
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Microsoft Fabric — SRE Architecture Simulator</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:           #001026;
      --bg-deep:      #000a14;
      --glass-bg:     rgba(255,255,255,0.04);
      --glass-border: rgba(255,255,255,0.09);
      --lime:         #dcfd8b;
      --cyan:         #00f0ff;
      --yellow:       #ffd700;
      --orange:       #ff8c00;
      --red:          #ff4a4a;
      --text:         #e2e8f0;
      --text-dim:     #64748b;
      --font-ui:      'Urbanist', 'Segoe UI', sans-serif;
      --font-mono:    'JetBrains Mono', monospace;
    }

    html, body { height: 100%; background: var(--bg); color: var(--text); font-family: var(--font-ui); overflow: hidden; }

    /* ── Scanline CRT overlay ── */
    .scanline-overlay {
      position: fixed; inset: 0; z-index: 9999; pointer-events: none;
      background: repeating-linear-gradient(
        0deg,
        rgba(0,0,0,.014) 0px, rgba(0,0,0,.014) 1px,
        transparent 1px, transparent 3px
      );
    }

    /* ── Native window bar ── */
    .window-bar {
      height: 32px; background: #000a14; flex-shrink: 0;
      display: flex; align-items: center; padding: 0 16px;
      border-bottom: 1px solid rgba(255,255,255,.04);
      position: relative; user-select: none;
    }
    .wb-controls { display: flex; gap: 7px; align-items: center; }
    .wb-btn {
      width: 12px; height: 12px; border-radius: 50%; cursor: default;
      display: flex; align-items: center; justify-content: center;
      font-size: 0; transition: filter .15s;
    }
    .wb-btn:hover { filter: brightness(1.3); }
    .wb-btn:hover::before { font-size: 8px; font-weight: 900; color: rgba(0,0,0,.5); }
    .wb-close { background: #ff5f56; } .wb-close:hover::before { content: '✕'; }
    .wb-min   { background: #ffbd2e; } .wb-min:hover::before   { content: '−'; }
    .wb-max   { background: #27c93f; } .wb-max:hover::before   { content: '+'; }
    .wb-title {
      position: absolute; left: 50%; transform: translateX(-50%);
      font-family: var(--font-mono); font-size: 10.5px; color: #475569;
      letter-spacing: .2px; pointer-events: none; white-space: nowrap;
    }
    .wb-right { margin-left: auto; display: flex; align-items: center; gap: 8px; }
    .wb-live-dot { width: 7px; height: 7px; border-radius: 50%; background: #27c93f; box-shadow: 0 0 7px #27c93f; animation: pulse 2.2s infinite; }
    .wb-live-label { font-family: var(--font-mono); font-size: 9px; color: #27c93f; letter-spacing: .8px; font-weight: 700; }

    /* ── Infra badges (tab bar) ── */
    .infra-badges { margin-left: auto; display: flex; align-items: center; gap: 7px; padding-right: 2px; }
    .infra-badge  { font-family: var(--font-mono); font-size: 9px; font-weight: 700; padding: 3px 8px; border-radius: 4px; letter-spacing: .4px; white-space: nowrap; }
    .badge-tenant { background: rgba(0,240,255,.07); border: 1px solid rgba(0,240,255,.18); color: rgba(0,240,255,.7); }
    .badge-region { background: rgba(220,253,139,.07); border: 1px solid rgba(220,253,139,.25); color: var(--lime); transition: all .5s; }
    .badge-region.region-fail { background: rgba(255,74,74,.09); border-color: rgba(255,74,74,.38); color: var(--red); }

    /* ── App shell ── */
    .app {
      display: flex; flex-direction: column;
      height: 100vh; position: relative;
      transform-origin: top left;
    }

    /* ── Topbar ── */
    .topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 20px; height: 52px; flex-shrink: 0;
      background: rgba(0,10,20,0.88); border-bottom: 1px solid var(--glass-border);
      backdrop-filter: blur(12px); z-index: 10;
    }
    .topbar-brand { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 14px; letter-spacing: .4px; }
    .topbar-brand .pulse-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); animation: pulse 2s infinite; }
    .topbar-right { display: flex; align-items: center; gap: 6px; }
    .topbar-meta { font-size: 11px; color: var(--text-dim); font-family: var(--font-mono); margin-right: 10px; }
    .topbar-btn {
      display: flex; align-items: center; gap: 5px;
      padding: 5px 11px; border-radius: 6px; border: 1px solid var(--glass-border);
      background: var(--glass-bg); color: var(--text-dim); font-size: 11px;
      cursor: pointer; transition: all .2s; font-family: var(--font-ui); font-weight: 600;
    }
    .topbar-btn:hover { color: var(--cyan); border-color: rgba(0,240,255,.3); }
    .topbar-btn .kbd { font-family: var(--font-mono); font-size: 9px; padding: 1px 4px; border-radius: 3px; background: rgba(255,255,255,.07); }

    /* ── Fullscreen mode ── */
    .focus-mode .topbar,
    .focus-mode .footer-quote { display: none !important; }

    /* ── Tabs ── */
    .tabs { display: flex; gap: 2px; padding: 0 20px; background: rgba(0,10,20,0.65); border-bottom: 1px solid var(--glass-border); flex-shrink: 0; }
    .tab-btn {
      padding: 10px 20px; font-size: 12px; font-weight: 600; cursor: pointer;
      border: none; background: transparent; color: var(--text-dim);
      border-bottom: 2px solid transparent; transition: all .2s; font-family: var(--font-ui);
    }
    .tab-btn:hover { color: var(--text); }
    .tab-btn.active { color: var(--cyan); border-bottom-color: var(--cyan); }
    .tab-btn i { margin-right: 6px; }

    .tab-content { display: none; flex: 1; overflow: hidden; }
    .tab-content.active { display: flex; flex-direction: column; }

    /* ── Simulator grid ── */
    .sim-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr auto;
      gap: 12px; padding: 12px;
      flex: 1; overflow: hidden;
    }
    .module {
      background: var(--glass-bg); border: 1px solid var(--glass-border);
      border-radius: 12px; backdrop-filter: blur(10px);
      padding: 16px; display: flex; flex-direction: column; gap: 10px;
      overflow-y: auto;
    }
    .module.full-width { grid-column: 1 / -1; }
    .module::-webkit-scrollbar { width: 3px; }
    .module::-webkit-scrollbar-thumb { background: rgba(255,255,255,.08); }

    .module-title {
      font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
      color: var(--cyan); display: flex; align-items: center; gap: 7px; flex-shrink: 0;
    }
    .badge { font-size: 9px; padding: 2px 7px; border-radius: 20px; background: rgba(0,240,255,.1); border: 1px solid rgba(0,240,255,.25); color: var(--cyan); }

    /* ── Buttons ── */
    .btn {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 8px 13px; border-radius: 7px; border: none; cursor: pointer;
      font-family: var(--font-ui); font-size: 11px; font-weight: 600;
      transition: all .18s; white-space: nowrap;
    }
    .btn-primary  { background: rgba(220,253,139,.1);  border: 1px solid rgba(220,253,139,.3);  color: var(--lime); }
    .btn-danger   { background: rgba(255,74,74,.1);    border: 1px solid rgba(255,74,74,.3);    color: var(--red); }
    .btn-warning  { background: rgba(255,215,0,.1);    border: 1px solid rgba(255,215,0,.3);    color: var(--yellow); }
    .btn-cyan     { background: rgba(0,240,255,.08);   border: 1px solid rgba(0,240,255,.25);   color: var(--cyan); }
    .btn-ghost    { background: rgba(255,255,255,.04);  border: 1px solid var(--glass-border);   color: var(--text-dim); }
    .btn:hover    { transform: translateY(-1px); filter: brightness(1.18); }
    .btn:active   { transform: translateY(0); }
    .btn:disabled { opacity: .38; cursor: not-allowed; transform: none; filter: none; }
    .btn .kbd-hint { font-family: var(--font-mono); font-size: 9px; opacity: .5; padding: 1px 4px; background: rgba(255,255,255,.07); border-radius: 3px; }
    .btn-row { display: flex; gap: 6px; flex-wrap: wrap; flex-shrink: 0; }

    /* ── Metric cards ── */
    .metrics-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 6px; flex-shrink: 0; }
    .metric-card {
      background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.07);
      border-radius: 7px; padding: 6px 8px; display: flex; flex-direction: column; gap: 2px;
    }
    .metric-value { font-family: var(--font-mono); font-size: 12px; font-weight: 700; transition: color .3s; }
    .metric-label { font-size: 8px; color: var(--text-dim); text-transform: uppercase; letter-spacing: .7px; }

    /* ── Direct Lake Fallback Indicator ── */
    .dl-fallback {
      display: flex; align-items: center; gap: 7px;
      padding: 4px 10px; border-radius: 6px; font-family: var(--font-mono);
      font-size: 9.5px; border: 1px solid transparent; transition: all .4s;
    }
    .dl-fallback.inactive { opacity: .25; color: var(--text-dim); border-color: transparent; }
    .dl-fallback.active   {
      color: var(--yellow); background: rgba(255,215,0,.07);
      border-color: rgba(255,215,0,.3);
      animation: fallback-blink .85s ease-in-out infinite;
    }
    @keyframes fallback-blink { 0%,100%{opacity:1} 50%{opacity:.45} }

    /* ── CU Chart ── */
    .chart-wrapper {
      border-radius: 7px; overflow: hidden;
      border: 1px solid rgba(255,255,255,.06); flex-shrink: 0; height: 120px;
    }
    canvas#cu-chart { display: block; width: 100%; height: 100%; }

    /* ── Status badge ── */
    .status-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px; border-radius: 20px; font-size: 11px; font-weight: 700; transition: all .4s; }
    .status-badge .dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-healthy  { background: rgba(220,253,139,.08);  border: 1px solid rgba(220,253,139,.35); color: var(--lime); }
    .status-healthy  .dot { background: var(--lime); box-shadow: 0 0 6px var(--lime); }
    .status-latency  { background: rgba(255,215,0,.08);    border: 1px solid rgba(255,215,0,.35);  color: var(--yellow); }
    .status-latency  .dot { background: var(--yellow); box-shadow: 0 0 6px var(--yellow); }
    .status-throttled{ background: rgba(255,140,0,.08);   border: 1px solid rgba(255,140,0,.35);  color: var(--orange); }
    .status-throttled .dot { background: var(--orange); box-shadow: 0 0 6px var(--orange); }
    .status-blocked  { background: rgba(255,74,74,.1);    border: 1px solid rgba(255,74,74,.35);  color: var(--red); }
    .status-blocked  .dot { background: var(--red); box-shadow: 0 0 6px var(--red); animation: pulse .65s infinite; }

    /* ── Mini console ── */
    .mini-console {
      background: var(--bg-deep); border: 1px solid var(--glass-border); border-radius: 7px;
      padding: 8px 10px; font-family: var(--font-mono); font-size: 10.5px;
      flex: 1; overflow-y: auto; min-height: 70px;
    }
    .log-line { padding: 1px 0; line-height: 1.55; }
    .log-info  { color: #64d2ff; }
    .log-ok    { color: var(--lime); }
    .log-warn  { color: var(--yellow); }
    .log-error { color: var(--red); }
    .log-dim   { color: var(--text-dim); }

    /* ── DATA LAYER (Pilar 2) ── */
    .data-layer {
      background: rgba(0,240,255,.03); border: 1px solid rgba(0,240,255,.12);
      border-radius: 8px; padding: 8px 12px; flex-shrink: 0;
    }
    .dl-header { font-size: 9px; font-weight: 700; letter-spacing: 1.2px; color: rgba(0,240,255,.5); text-transform: uppercase; margin-bottom: 6px; }
    .dl-flow { display: flex; align-items: center; gap: 0; }
    .dl-node {
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      padding: 5px 9px; border-radius: 7px; border: 1px solid rgba(255,255,255,.08);
      background: rgba(255,255,255,.03); transition: all .4s; flex-shrink: 0;
    }
    .dl-node i { font-size: 13px; }
    .dl-node-name { font-size: 9px; font-weight: 700; color: var(--text-dim); }
    .dl-node-sub { font-size: 8px; color: #334155; font-family: var(--font-mono); }
    .dl-node.active-node { border-color: rgba(0,240,255,.3); background: rgba(0,240,255,.06); }
    .dl-node.active-node .dl-node-name { color: var(--cyan); }
    .dl-node.center-node { border-color: rgba(0,240,255,.4); background: rgba(0,240,255,.08); padding: 6px 12px; }
    .dl-node.center-node i { font-size: 15px; color: var(--cyan); }
    .dl-node.center-node .dl-node-name { color: var(--cyan); font-size: 10px; }
    .dl-node.dead-node { border-color: rgba(255,74,74,.3) !important; background: rgba(255,74,74,.06) !important; }
    .dl-node.dead-node i, .dl-node.dead-node .dl-node-name { color: var(--red) !important; }

    .dl-connector { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; position: relative; min-width: 50px; }
    .dl-line { width: 100%; height: 2px; position: relative; overflow: visible; }
    .dl-line::before {
      content: ''; position: absolute; inset: 0;
      background: repeating-linear-gradient(90deg, rgba(0,240,255,.28) 0, rgba(0,240,255,.28) 6px, transparent 6px, transparent 14px);
      background-size: 14px 2px;
      animation: dash-scroll .65s linear infinite;
    }
    /* Glowing pulse — left-to-right on left connector, right-to-left on right connector */
    .dl-line::after {
      content: '';
      position: absolute; top: -5px; left: -64px;
      width: 64px; height: 12px; border-radius: 6px;
      background: radial-gradient(ellipse at center, rgba(0,240,255,.95) 0%, rgba(0,240,255,.4) 40%, transparent 70%);
      animation: glow-lr 2.6s ease-in-out infinite;
      pointer-events: none;
    }
    #dl-line-right::after {
      animation: glow-rl 2.6s ease-in-out infinite;
      animation-delay: -1.3s;
    }
    .dl-line.dead-line::before {
      background: repeating-linear-gradient(90deg, rgba(255,74,74,.3) 0, rgba(255,74,74,.3) 6px, transparent 6px, transparent 14px);
      animation: none;
    }
    .dl-line.dead-line::after { display: none; }
    .dl-lbl { font-size: 8px; color: rgba(0,240,255,.45); letter-spacing: .5px; font-family: var(--font-mono); }
    .dl-lbl.dead-lbl { color: rgba(255,74,74,.4); }
    .dl-no-copy { font-size: 8px; color: #2a4060; font-style: italic; margin-top: 2px; text-align: center; }

    @keyframes dash-scroll { to { background-position: 14px 0; } }
    @keyframes glow-lr {
      0%   { left: -64px; opacity: 0; }
      12%  { opacity: 1; }
      88%  { opacity: 1; }
      100% { left: 100%; opacity: 0; }
    }
    @keyframes glow-rl {
      0%   { left: 100%; opacity: 0; }
      12%  { opacity: 1; }
      88%  { opacity: 1; }
      100% { left: -64px; opacity: 0; }
    }

    /* ── BCDR Regions ── */
    .regions-row { display: flex; gap: 10px; flex-shrink: 0; }
    .region-card {
      flex: 1; border-radius: 9px; padding: 10px 12px;
      border: 1px solid var(--glass-border); background: rgba(255,255,255,.02);
      transition: all .5s;
    }
    .region-card.active-region  { border-color: rgba(220,253,139,.35); background: rgba(220,253,139,.03); }
    .region-card.dead-region    { border-color: rgba(255,74,74,.35);   background: rgba(255,74,74,.04); }
    .region-card.online-region  { border-color: rgba(0,240,255,.4);    background: rgba(0,240,255,.04); box-shadow: 0 0 18px rgba(0,240,255,.07); }

    .region-name { font-size: 11px; font-weight: 700; margin-bottom: 8px; }
    .region-services { display: flex; flex-direction: column; gap: 4px; }
    .svc-row { display: flex; align-items: center; gap: 7px; font-size: 10px; line-height: 1.3; }
    .svc-icon { width: 22px; height: 22px; border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0; }
    .svc-ok   { background: rgba(220,253,139,.1);  color: var(--lime); }
    .svc-off  { background: rgba(255,74,74,.1);    color: var(--red); }
    .svc-cyan { background: rgba(0,240,255,.08);   color: var(--cyan); }
    .svc-dim  { background: rgba(255,255,255,.04); color: #475569; }

    /* ── Failover steps ── */
    .failover-steps { display: flex; flex-direction: column; gap: 4px; flex-shrink: 0; }
    .step-row { display: flex; align-items: center; gap: 8px; font-size: 10px; padding: 3px 0; }
    .step-icon { width: 16px; text-align: center; flex-shrink: 0; }
    .step-bar-wrap { flex: 1; height: 4px; background: rgba(255,255,255,.06); border-radius: 2px; overflow: hidden; }
    .step-bar-fill { height: 100%; width: 0%; border-radius: 2px; background: var(--lime); transition: width 1.1s ease; }

    /* ── RTO elements ── */
    .rto-counter { font-family: var(--font-mono); font-size: 11px; color: var(--red); display: none; align-items: center; gap: 7px; flex-shrink: 0; }
    .rto-comparison {
      display: none; border-radius: 9px; overflow: hidden;
      border: 1px solid rgba(220,253,139,.25); flex-shrink: 0;
    }
    .rto-comparison.visible { display: grid; grid-template-columns: 1fr 1fr; }
    .rto-col { padding: 9px 12px; }
    .rto-col.bad  { background: rgba(255,74,74,.07); border-right: 1px solid rgba(255,255,255,.06); }
    .rto-col.good { background: rgba(220,253,139,.06); }
    .rto-col-label { font-size: 9px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; color: var(--text-dim); }
    .rto-col-value { font-family: var(--font-mono); font-size: 15px; font-weight: 700; }
    .rto-col.bad  .rto-col-value { color: var(--red); }
    .rto-col.good .rto-col-value { color: var(--lime); }
    .rto-col-sub { font-size: 9px; color: var(--text-dim); margin-top: 2px; }

    /* ── Big console (drift) ── */
    .big-console {
      background: var(--bg-deep); border: 1px solid var(--glass-border); border-radius: 8px;
      padding: 10px 12px; font-family: var(--font-mono); font-size: 11px;
      flex: 1; overflow-y: auto; min-height: 60px;
    }
    .console-line { padding: 1px 0; line-height: 1.6; }
    .blink { animation: blink .6s step-end infinite; }

    /* ── CODE TAB ── */
    .code-tab { flex: 1; display: flex; flex-direction: column; gap: 0; overflow: hidden; }
    .env-switcher-bar {
      display: flex; align-items: center; gap: 10px; padding: 8px 16px;
      background: rgba(0,10,20,.7); border-bottom: 1px solid var(--glass-border); flex-shrink: 0;
    }
    .env-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--text-dim); }
    .env-btn {
      padding: 5px 14px; border-radius: 6px; border: 1px solid var(--glass-border);
      background: var(--glass-bg); color: var(--text-dim); font-size: 11px; font-weight: 700;
      cursor: pointer; transition: all .2s; font-family: var(--font-mono);
    }
    .env-btn:hover { filter: brightness(1.2); }
    .env-btn.env-dev.active  { background: rgba(100,210,255,.1);  border-color: #64d2ff; color: #64d2ff; }
    .env-btn.env-stg.active  { background: rgba(255,215,0,.1);    border-color: var(--yellow); color: var(--yellow); }
    .env-btn.env-prod.active { background: rgba(220,253,139,.1);  border-color: var(--lime); color: var(--lime); }
    .env-hint { margin-left: auto; font-size: 10px; color: #2a4060; font-family: var(--font-mono); }

    .code-panes { display: flex; gap: 16px; flex: 1; overflow: hidden; padding: 12px; }
    .code-pane {
      flex: 1; background: var(--bg-deep); border: 1px solid var(--glass-border);
      border-radius: 12px; overflow: hidden; display: flex; flex-direction: column;
    }
    .code-titlebar {
      display: flex; align-items: center; gap: 8px; padding: 9px 14px;
      border-bottom: 1px solid var(--glass-border); background: rgba(255,255,255,.015);
    }
    .traffic-lights { display: flex; gap: 5px; }
    .tl { width: 10px; height: 10px; border-radius: 50%; }
    .tl.red { background: #ff5f57; } .tl.yellow { background: #febc2e; } .tl.green { background: #28c840; }
    .code-filename { font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); }
    .code-body { display: flex; flex: 1; overflow: auto; }
    .line-numbers {
      padding: 12px 10px 12px 14px; text-align: right; font-family: var(--font-mono);
      font-size: 11.5px; color: #2a3a4a; line-height: 1.7; user-select: none;
      border-right: 1px solid var(--glass-border); background: rgba(0,0,0,.2); flex-shrink: 0; min-width: 42px;
    }
    .code-content { padding: 12px 18px; font-family: var(--font-mono); font-size: 11.5px; line-height: 1.7; flex: 1; white-space: pre; }

    /* JSON syntax */
    .j-key  { color: #79d4fd; }
    .j-str  { color: #ce9178; }
    .j-expr { color: var(--lime); font-weight: 600; }
    .j-mut  { transition: color .3s, background .3s; }

    .hl-cyan { background: rgba(0,240,255,.07); border-left: 2px solid var(--cyan); padding-left: 6px; margin-left: -6px; display: block; }
    .hl-lime { background: rgba(220,253,139,.07); border-left: 2px solid var(--lime); padding-left: 6px; margin-left: -6px; display: block; }

    .env-flash { animation: env-change .5s ease; }
    @keyframes env-change { 0%,100%{opacity:1} 30%{opacity:0} }

    /* ── SRE Insight panel ── */
    .insight-panel {
      width: 250px; flex-shrink: 0; background: rgba(0,240,255,.03);
      border: 1px solid rgba(0,240,255,.18); border-radius: 12px; padding: 16px;
      display: flex; flex-direction: column; gap: 10px; overflow-y: auto;
    }
    .insight-label { font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--cyan); display: flex; align-items: center; gap: 5px; }
    .insight-text { font-size: 11.5px; line-height: 1.65; color: #94a3b8; }
    .insight-text em { color: var(--lime); font-style: normal; font-weight: 600; }
    .insight-tag { display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 20px; font-size: 9px; font-weight: 700; background: rgba(220,253,139,.08); border: 1px solid rgba(220,253,139,.25); color: var(--lime); }

    /* ── PRESENTER PANEL ── */
    .presenter-panel {
      position: fixed; top: 0; right: 0; bottom: 0; width: 290px; z-index: 100;
      background: rgba(0,8,18,.97); border-left: 1px solid rgba(0,240,255,.2);
      backdrop-filter: blur(20px); transform: translateX(100%);
      transition: transform .3s cubic-bezier(.4,0,.2,1);
      display: flex; flex-direction: column; overflow: hidden;
    }
    .presenter-panel.open { transform: translateX(0); }
    .pp-header {
      display: flex; align-items: center; gap: 8px; padding: 14px 16px;
      border-bottom: 1px solid rgba(0,240,255,.15); flex-shrink: 0;
      font-size: 12px; font-weight: 700; color: var(--cyan); letter-spacing: .5px;
    }
    .pp-header .pp-close { margin-left: auto; cursor: pointer; color: var(--text-dim); font-size: 14px; }
    .pp-header .pp-close:hover { color: var(--text); }
    .pp-scroll { flex: 1; overflow-y: auto; padding: 12px; }
    .pp-pilar { margin-bottom: 14px; }
    .pp-pilar-title {
      font-size: 9px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;
      color: var(--cyan); margin-bottom: 8px; padding-bottom: 5px;
      border-bottom: 1px solid rgba(0,240,255,.12);
    }
    .pp-step {
      display: flex; align-items: flex-start; gap: 8px;
      padding: 6px 8px; border-radius: 6px; margin-bottom: 4px;
      cursor: pointer; transition: background .15s; border: 1px solid transparent;
    }
    .pp-step:hover { background: rgba(255,255,255,.03); }
    .pp-step.done { opacity: .45; }
    .pp-step.done .pp-check { background: var(--lime); border-color: var(--lime); color: var(--bg); }
    .pp-check {
      width: 16px; height: 16px; border-radius: 4px; border: 1px solid #334155;
      display: flex; align-items: center; justify-content: center; font-size: 9px;
      flex-shrink: 0; margin-top: 1px; transition: all .2s;
    }
    .pp-step-content { flex: 1; }
    .pp-step-label { font-size: 11px; color: var(--text); line-height: 1.4; }
    .pp-step-hint { font-size: 9.5px; color: var(--text-dim); margin-top: 2px; line-height: 1.3; }
    .pp-kbd { display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-size: 9px; padding: 1px 5px; border-radius: 3px; background: rgba(0,240,255,.1); border: 1px solid rgba(0,240,255,.25); color: var(--cyan); margin-right: 3px; }
    .pp-footer { padding: 10px 12px; border-top: 1px solid rgba(255,255,255,.06); flex-shrink: 0; }
    .pp-shortcuts { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
    .pp-sc-item { display: flex; align-items: center; gap: 5px; font-size: 10px; color: var(--text-dim); }

    /* ── Footer ── */
    .footer-quote {
      flex-shrink: 0; padding: 5px 24px;
      background: rgba(0,10,20,.75); border-top: 1px solid rgba(220,253,139,.06);
      font-size: 10px; color: #263040; font-style: italic; text-align: center;
    }
    .footer-quote em { color: rgba(220,253,139,.28); font-style: normal; }

    /* ── Business Impact Panel ── */
    .impact-panel {
      display: flex; align-items: flex-start; gap: 8px;
      padding: 7px 10px; border-radius: 7px; font-size: 10.5px; line-height: 1.5;
      border: 1px solid transparent; flex-shrink: 0; transition: background .4s, border-color .4s;
    }
    .impact-panel .ip-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; margin-top: 2px; transition: background .4s; }
    .impact-healthy     { background: rgba(220,253,139,.04); border-color: rgba(220,253,139,.18); color: #64748b; }
    .impact-healthy     .ip-dot { background: var(--lime); }
    .impact-warning     { background: rgba(255,215,0,.05);  border-color: rgba(255,215,0,.25);  color: #94a3b8; }
    .impact-warning     .ip-dot { background: var(--yellow); animation: pulse 1.2s infinite; }
    .impact-critical    { background: rgba(255,74,74,.07);  border-color: rgba(255,74,74,.35);  color: #fca5a5; animation: flashred .9s infinite; }
    .impact-critical    .ip-dot { background: var(--red); animation: pulse .55s infinite; }
    .impact-catastrophe { background: rgba(255,74,74,.13); border-color: rgba(255,74,74,.6);   color: var(--red); font-weight: 700; animation: flashred .45s infinite; }
    .impact-catastrophe .ip-dot { background: var(--red); box-shadow: 0 0 8px var(--red); animation: pulse .35s infinite; }

    /* ── Gift / SRE Checklist Modal ── */
    .gift-topbar-btn {
      background: rgba(220,253,139,.1); border: 1px solid rgba(220,253,139,.38); color: var(--lime);
      animation: gift-glow 2.8s ease-in-out infinite;
    }
    .gift-topbar-btn:hover { background: rgba(220,253,139,.18); filter: brightness(1.15); }
    @keyframes gift-glow {
      0%   { box-shadow: 0 0 0 rgba(220,253,139,0); }
      50%  { box-shadow: 0 0 14px rgba(220,253,139,.35); }
      100% { box-shadow: 0 0 0 rgba(220,253,139,0); }
    }

    .modal-overlay {
      position: fixed; inset: 0; z-index: 300;
      background: rgba(0,5,16,.78); backdrop-filter: blur(18px);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity .22s;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal-box {
      background: rgba(0,10,24,.98); border: 1px solid rgba(0,240,255,.22);
      border-radius: 16px; width: 700px; max-width: 92vw; max-height: 86vh;
      display: flex; flex-direction: column; overflow: hidden;
      box-shadow: 0 0 60px rgba(0,240,255,.07), 0 28px 70px rgba(0,0,0,.6);
    }
    .modal-header {
      display: flex; align-items: center; gap: 10px; padding: 16px 20px;
      border-bottom: 1px solid rgba(0,240,255,.14); flex-shrink: 0; background: rgba(0,240,255,.02);
    }
    .modal-title { font-size: 14px; font-weight: 700; color: var(--lime); }
    .modal-sub   { font-size: 11px; color: var(--text-dim); margin-top: 1px; }
    .modal-close { margin-left: auto; cursor: pointer; color: var(--text-dim); font-size: 18px; padding: 2px 6px; border-radius: 4px; }
    .modal-close:hover { background: rgba(255,255,255,.06); color: var(--text); }
    .modal-body  { flex: 1; overflow-y: auto; padding: 16px 20px; display: flex; flex-direction: column; gap: 18px; }
    .modal-section-title { font-size: 10px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; color: var(--cyan); margin-bottom: 8px; display: flex; align-items: center; gap: 6px; }
    .cl-grid { display: flex; flex-direction: column; gap: 2px; }
    .cl-item {
      display: flex; align-items: center; gap: 10px; padding: 7px 10px;
      border-radius: 7px; cursor: pointer; user-select: none;
      border: 1px solid transparent;
      transition: background .15s, border-color .15s;
      font-size: 11px;
    }
    .cl-item:hover { background: rgba(255,255,255,.04); }
    .cl-item.done { background: rgba(220,253,139,.06); border-color: rgba(220,253,139,.2); }

    .cl-check {
      width: 17px; height: 17px; border-radius: 5px; flex-shrink: 0;
      border: 1.5px solid rgba(255,255,255,.2);
      display: flex; align-items: center; justify-content: center;
      transition: all .2s;
    }
    .cl-check i { display: none; font-size: 9px; color: #0f172a; font-weight: 900; }
    .cl-item.done .cl-check { background: var(--lime); border-color: var(--lime); }
    .cl-item.done .cl-check i { display: block; }
    .cl-item.done .cl-label { color: var(--text-dim); text-decoration: line-through; }

    .cl-progress {
      margin-left: auto; font-size: 9.5px; font-family: var(--font-mono);
      color: var(--text-dim); padding: 3px 9px; border-radius: 20px;
      background: rgba(255,255,255,.05); border: 1px solid var(--glass-border);
      transition: color .3s, border-color .3s; white-space: nowrap;
    }
    .cl-progress.complete { color: var(--lime); border-color: rgba(220,253,139,.4); }

    /* light mode checklist */
    body.light-mode .cl-check { border-color: #cbd5e1; }
    body.light-mode .cl-item:hover { background: rgba(0,0,0,.04); }
    body.light-mode .cl-item.done { background: rgba(101,163,13,.06); border-color: rgba(101,163,13,.25); }
    body.light-mode .cl-item.done .cl-check { background: var(--lime); border-color: var(--lime); }
    body.light-mode .cl-item.done .cl-check i { color: #fff; }
    body.light-mode .cl-progress { background: rgba(0,0,0,.04); border-color: #e2e8f0; }
    .json-block {
      background: var(--bg-deep); border: 1px solid var(--glass-border); border-radius: 8px;
      padding: 12px 14px; font-family: var(--font-mono); font-size: 10.5px;
      line-height: 1.7; color: #79d4fd; overflow-x: auto; white-space: pre;
    }
    .json-block .j-key { color: #79d4fd; } .json-block .j-str { color: #ce9178; } .json-block .j-num { color: #b5cea8; }
    .modal-footer { padding: 12px 20px; border-top: 1px solid rgba(255,255,255,.06); flex-shrink: 0; display: flex; justify-content: flex-end; gap: 8px; }

    /* ── Theme transition helpers ── */
    .module, .topbar, .tabs, .window-bar, .metric-card, .region-card,
    .data-layer, .dl-node, .insight-panel, .impact-panel, .footer-quote,
    .presenter-panel, .modal-box, .modal-header, .infra-badge, .topbar-btn,
    .rto-col, .env-switcher-bar, .code-titlebar {
      transition: background .3s, background-color .3s, border-color .3s, color .3s, box-shadow .3s;
    }

    /* ══════════════════════════════════════════
       LIGHT MODE — Datadog/Azure Portal premium
    ══════════════════════════════════════════ */
    body.light-mode {
      --bg:           #f1f5f9;
      --bg-deep:      #f8fafc;
      --glass-bg:     rgba(255,255,255,0.88);
      --glass-border: #cbd5e1;
      --text:         #0f172a;
      --text-dim:     #64748b;
      --cyan:         #0891b2;
      --lime:         #65a30d;
      --yellow:       #b45309;
      --orange:       #c2410c;
      --red:          #dc2626;
      background: var(--bg);
    }

    /* Frame */
    body.light-mode .window-bar { background: #e2e8f0; border-color: #cbd5e1; }
    body.light-mode .wb-title   { color: #94a3b8; }
    body.light-mode .wb-live-dot    { background: #16a34a; box-shadow: 0 0 6px #16a34a; }
    body.light-mode .wb-live-label  { color: #16a34a; }
    body.light-mode .topbar  { background: rgba(248,250,252,.94); border-color: #e2e8f0; }
    body.light-mode .tabs    { background: rgba(241,245,249,.9);  border-color: #e2e8f0; }
    body.light-mode .footer-quote { background: rgba(241,245,249,.92); border-color: #e2e8f0; color: #94a3b8; }
    body.light-mode .footer-quote em { color: var(--lime); }

    /* Modules */
    body.light-mode .module {
      background: rgba(255,255,255,.88);
      border-color: #e2e8f0;
      box-shadow: 0 4px 12px -2px rgba(0,0,0,.07), 0 2px 4px -1px rgba(0,0,0,.04);
      backdrop-filter: none;
    }
    body.light-mode .metric-card { background: rgba(255,255,255,.95); border-color: #e2e8f0; }

    /* Buttons */
    body.light-mode .topbar-btn { background: rgba(0,0,0,.04); border-color: #e2e8f0; color: #64748b; }
    body.light-mode .topbar-btn:hover { color: var(--cyan); border-color: rgba(8,145,178,.4); }
    body.light-mode .gift-topbar-btn { background: rgba(101,163,13,.09); border-color: rgba(101,163,13,.35); color: var(--lime); }
    body.light-mode .btn-ghost { background: rgba(0,0,0,.04); border-color: #e2e8f0; color: #64748b; }

    /* ── Consoles ALWAYS dark — untouchable ── */
    body.light-mode .mini-console,
    /* ── Consoles & chart — navy profundo, no negro puro (armoniza con light mode) ── */
    body.light-mode .mini-console,
    body.light-mode .big-console,
    body.light-mode #bcdr-console {
      background: #0f1e2e !important;
      border-color: #1e3a52 !important;
      box-shadow: 0 2px 10px rgba(0,0,0,.14);
    }
    body.light-mode .chart-wrapper {
      background: #0f1e2e !important;
      border-color: #1e3a52 !important;
      box-shadow: 0 2px 10px rgba(0,0,0,.14);
    }

    /* Code IDE — navy oscuro, título con borde sutil */
    body.light-mode .code-pane     { background: #0f1e2e !important; }
    body.light-mode .code-titlebar {
      background: #091624 !important;
      border-color: #1e3a52 !important;
      box-shadow: 0 1px 0 #1e3a52;
    }
    body.light-mode .code-titlebar .code-filename { color: #64748b !important; }
    body.light-mode .line-numbers  {
      background: #091624 !important;
      border-color: #1e3a52 !important;
      color: #2a4060 !important;
    }
    body.light-mode .code-content  { background: #0f1e2e !important; }
    body.light-mode .json-block    { background: #0f1e2e !important; border-color: #1e3a52 !important; }

    /* Modal */
    body.light-mode .modal-box    { background: rgba(248,250,252,.99); border-color: #e2e8f0; box-shadow: 0 28px 70px rgba(0,0,0,.12); }
    body.light-mode .modal-header { background: rgba(241,245,249,.9);  border-color: #e2e8f0; }
    body.light-mode .cl-item:hover { background: rgba(0,0,0,.03); }

    /* Presenter panel */
    body.light-mode .presenter-panel { background: rgba(248,250,252,.99); border-color: #e2e8f0; }
    body.light-mode .pp-pilar-title  { border-color: #e2e8f0; }
    body.light-mode .pp-step:hover   { background: rgba(0,0,0,.03); }

    /* Data layer */
    body.light-mode .data-layer { background: rgba(255,255,255,.6); border-color: #e2e8f0; }
    body.light-mode .dl-node { background: rgba(255,255,255,.8); border-color: #e2e8f0; }
    body.light-mode .dl-node.center-node { border-color: rgba(8,145,178,.45); background: rgba(8,145,178,.08); }

    /* BCDR regions */
    body.light-mode .region-card { background: rgba(255,255,255,.7); border-color: #e2e8f0; }
    body.light-mode .region-card.active-region { border-color: rgba(101,163,13,.45); background: rgba(101,163,13,.06); }
    body.light-mode .region-card.dead-region   { border-color: rgba(220,38,38,.4);   background: rgba(220,38,38,.05); }
    body.light-mode .region-card.online-region { border-color: rgba(8,145,178,.45);  background: rgba(8,145,178,.06); }

    /* Impact panel */
    body.light-mode .impact-healthy     { background: rgba(101,163,13,.06); border-color: rgba(101,163,13,.3); }
    body.light-mode .impact-warning     { background: rgba(180,83,9,.06);   border-color: rgba(180,83,9,.3); color: #92400e; }
    body.light-mode .impact-critical    { background: rgba(220,38,38,.06);  border-color: rgba(220,38,38,.35); }
    body.light-mode .impact-catastrophe { background: rgba(220,38,38,.1);   border-color: rgba(220,38,38,.5); }

    /* Direct Lake fallback — orange/ocre en light mode */
    body.light-mode .dl-fallback.active {
      color: var(--orange) !important;
      background: rgba(194,65,12,.07) !important;
      border-color: rgba(194,65,12,.3) !important;
    }

    /* RTO */
    body.light-mode .rto-comparison { border-color: rgba(101,163,13,.3); }
    body.light-mode .rto-col.bad  { background: rgba(220,38,38,.06); }
    body.light-mode .rto-col.good { background: rgba(101,163,13,.07); }

    /* Infra badges */
    body.light-mode .badge-tenant { background: rgba(8,145,178,.07); border-color: rgba(8,145,178,.25); color: var(--cyan); }
    body.light-mode .badge-region { background: rgba(101,163,13,.07); border-color: rgba(101,163,13,.3); color: var(--lime); }
    body.light-mode .badge-region.region-fail { background: rgba(220,38,38,.08); border-color: rgba(220,38,38,.35); color: var(--red); }

    /* Env switcher */
    body.light-mode .env-switcher-bar { background: rgba(241,245,249,.92); border-color: #e2e8f0; }

    /* Insight panel */
    body.light-mode .insight-panel { background: rgba(255,255,255,.85); border-color: #e2e8f0; }
    body.light-mode .insight-tag { background: rgba(101,163,13,.09); border-color: rgba(101,163,13,.3); }

    /* Scanline — reducida en modo claro */
    body.light-mode .scanline-overlay { opacity: 0.3; }

    /* ── Animations ── */
    @keyframes pulse   { 0%,100%{opacity:1}50%{opacity:.35} }
    @keyframes blink   { 0%,100%{opacity:1}50%{opacity:0} }
    @keyframes slidein { from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none} }
    @keyframes flashred{ 0%,100%{background:rgba(255,74,74,0)}50%{background:rgba(255,74,74,.1)} }

    .flash-red  { animation: flashred .4s ease 3; }
    .animate-in { animation: slidein .25s ease; }

    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.08); border-radius: 2px; }
  </style>
</head>
<body>
<div class="scanline-overlay"></div>

<div class="app" id="app">

  <!-- ── Native window bar ── -->
  <div class="window-bar">
    <div class="wb-controls">
      <div class="wb-btn wb-close"></div>
      <div class="wb-btn wb-min"></div>
      <div class="wb-btn wb-max"></div>
    </div>
    <span class="wb-title">Fabric-SRE-Telemetry-Core // v2.4.1 (Connected)</span>
    <div class="wb-right">
      <div class="wb-live-dot"></div>
      <span class="wb-live-label">WS_LIVE</span>
    </div>
  </div>

  <!-- ── Topbar ── -->
  <div class="topbar" id="topbar">
    <div class="topbar-brand">
      <div class="pulse-dot"></div>
      <i class="fa-solid fa-diamond" style="color:var(--cyan);font-size:13px"></i>
      Microsoft Fabric — SRE Architecture Simulator
    </div>
    <div class="topbar-right">
      <span class="topbar-meta">Fabric Day 2026 &nbsp;|&nbsp; <span style="color:var(--lime)">LIVE</span></span>
      <button class="topbar-btn" id="theme-btn" onclick="toggleTheme()" title="Toggle Light/Dark mode">
        <i class="fa-solid fa-circle-half-stroke" id="theme-icon"></i>
      </button>
      <button class="topbar-btn gift-topbar-btn" onclick="toggleGift()">
        <i class="fa-solid fa-gift"></i> SRE Checklist &amp; Gift
      </button>
      <button class="topbar-btn" onclick="toggleFullscreen()" title="Focus mode (`)">
        <i class="fa-solid fa-expand" id="fs-icon"></i>
        <span class="kbd">`</span>
      </button>
      <button class="topbar-btn" onclick="togglePresenter()" title="Presenter panel (P)" style="color:var(--cyan);border-color:rgba(0,240,255,.25)">
        <i class="fa-solid fa-person-chalkboard"></i> Demo Guide
        <span class="kbd">P</span>
      </button>
    </div>
  </div>

  <!-- ── Tabs ── -->
  <div class="tabs" id="tabs-bar">
    <button class="tab-btn active" data-tab="simulator" onclick="switchTab('simulator')">
      <i class="fa-solid fa-tower-broadcast"></i>Live Simulator
    </button>
    <button class="tab-btn" data-tab="code" onclick="switchTab('code')">
      <i class="fa-solid fa-code"></i>Workspace as Code <span style="opacity:.5;font-size:9px;margin-left:3px">pipeline.json</span>
    </button>
    <div class="infra-badges">
      <span class="infra-badge badge-tenant">Tenant: F64_PROD</span>
      <span class="infra-badge badge-region" id="region-header-badge">Active Region: East US</span>
    </div>
  </div>

  <!-- ════════════════════════════════════════
       TAB 1 — LIVE SIMULATOR
  ════════════════════════════════════════ -->
  <div class="tab-content active" id="tab-simulator">
    <div class="sim-grid">

      <!-- ── MÓDULO 1: Capacidad & Smoothing ── -->
      <div class="module">
        <div class="module-title">
          <i class="fa-solid fa-chart-simple"></i>
          Capacidad &amp; Smoothing
          <span class="badge">PILAR 1</span>
        </div>

        <!-- Metric cards — F64 SKU real units -->
        <div class="metrics-row">
          <div class="metric-card">
            <div class="metric-value" id="metric-interactive" style="color:var(--cyan)">9.6 / 64 CU</div>
            <div class="metric-label">Interactivo ⏱ 5min</div>
          </div>
          <div class="metric-card">
            <div class="metric-value" id="metric-background" style="color:var(--lime)">5.1 / 64 CU</div>
            <div class="metric-label">Background ⏱ 24h</div>
